  </data>
  <data name="TimeShiftMemoryOff" xml:space="preserve">
    <value>Ki van kapcsolva, így nem használ memóriát. Bekapcsolva körülbelül {0} MB-ot használna a(z) {1} kedvencéhez.</value>
  </data>
