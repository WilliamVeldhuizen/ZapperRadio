  <data name="ShortcutsHeading.Text" xml:space="preserve">
    <value>快捷键</value>
  </data>
  <data name="ShortcutsText.Text" xml:space="preserve">
    <value>在窗口中：Ctrl+空格 停止或播放，Ctrl+M 静音，Ctrl+F 搜索。Windows 音量浮出控件、锁屏界面、键盘媒体键和耳机上的播放、暂停和下一首按钮同样有效，其中下一首和上一首会在收藏的电台间切换。</value>
  </data>
  <data name="GlobalHotkeysCheckBox.Content" xml:space="preserve">
