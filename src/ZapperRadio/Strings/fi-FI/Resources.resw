  <data name="ZapperHint.Text" xml:space="preserve">
    <value>Miten zapperi väistää mainoskatkot ja puheen kuuntelemallasi asemalla ja mitä se tekee katkon päätyttyä.</value>
  </data>
  <data name="ZapperSwitch.Header" xml:space="preserve">
