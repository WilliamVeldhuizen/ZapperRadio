  <data name="CrossfadeHeading.Text" xml:space="preserve">
    <value>क्रॉसफ़ेड</value>
  </data>
  <data name="CrossfadeText.Text" xml:space="preserve">
    <value>एक स्टेशन से दूसरे पर अचानक काटने के बजाय धीरे-धीरे बदलता है। फ़ेड आउट ब्रेक शुरू होने से पहले खत्म हो जाता है, इसलिए कोई विज्ञापन अंदर नहीं आता। जो स्टेशन टाइम-शिफ़्ट बफ़र के बजाय लाइव चल रहा है, उसे अब भी अचानक काटा जाता है, क्योंकि उसका ब्रेक पहले से सुनाई दे रहा है।</value>
  </data>
  <data name="CrossfadeCheckBox.Content" xml:space="preserve">
    <value>स्टेशन बदलते समय क्रॉसफ़ेड</value>
  </data>
  <data name="ZapTargetsHeading.Text" xml:space="preserve">
    <value>इन पर जाएँ</value>
  </data>
  <data name="ZapTargetsText.Text" xml:space="preserve">
    <value>वे पसंदीदा जिन पर ब्रेक के दौरान जाया जा सकता है। ऐसे स्टेशन को छोड़ दें जो संगीत का इंतज़ार करने लायक नहीं है, जैसे कोई समाचार स्टेशन; उससे हटना और उस पर लौटना फिर भी होता है।</value>
  </data>
  <data name="NoZapTargetsText.Text" xml:space="preserve">
    <value>अभी कोई पसंदीदा नहीं। ज़ैपर कहाँ जा सकता है यह चुनने के लिए स्टेशनों को पसंदीदा में जोड़ें।</value>
  </data>
  <data name="ZapToSongStartHeading.Text" xml:space="preserve">
    <value>गाने की शुरुआत पर जाएँ</value>
  </data>
  <data name="ZapToSongStartText.Text" xml:space="preserve">
    <value>स्टेशन बदलने पर आप ऐसे स्टेशन पर पहुँचते हैं जो गाना बजा रहा है, आमतौर पर उसके बीच में। उस गाने को शुरू से चलाने के लिए, हर पसंदीदा के आख़िरी कुछ मिनट मेमोरी में रखे जाते हैं (टाइम-शिफ़्ट बफ़र)। इससे ब्रेक को भी ठीक वहीं काटा जाता है जहाँ वह शुरू होता है, क्योंकि ब्रेक सुनाई देने से पहले ही पता होता है। तब आप प्रसारण से थोड़ा पीछे सुनते हैं, अधिकतम उस गाने की लंबाई जितना जिस पर पहुँचे थे, और लाइव पर जाएँ तुरंत बराबर कर देता है। बंद करने पर कोई बफ़र नहीं रखा जाता और उनकी मेमोरी खाली हो जाती है: हर स्टेशन लाइव चलता है, और स्टेशन बदलने पर आप गाने में जहाँ भी हो वहीं पहुँचते हैं।</value>
  </data>
