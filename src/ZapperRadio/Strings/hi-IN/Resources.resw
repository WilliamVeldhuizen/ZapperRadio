  <data name="RemeasureLoudnessButton.ToolTipService.ToolTip" xml:space="preserve">
    <value>अब तक हर पसंदीदा से जो सुना गया उसे भूलकर फिर से मापता है। लगभग एक मिनट का संगीत सुनाई देने तक आवाज़ मौजूदा सुधार पर रहती है, फिर नए नतीजे पर जाती है।</value>
  </data>
