  <data name="ZapperHint.Text" xml:space="preserve">
    <value>Jak zapper omija bloki reklamowe i mowę na słuchanej stacji i co robi po zakończeniu przerwy.</value>
  </data>
  <data name="ZapperSwitch.Header" xml:space="preserve">
