<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ZapperRadio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$(Platform.ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged app that carries the Windows App SDK runtime with it: just build and run. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without this, dotnet publish leaves out ZapperRadio.pri and the compiled .xbf XAML, and the app crashes on start. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>false</SelfContained>
    <!-- Program.cs starts the app itself, to pass jump list clicks on to the instance already running. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.30.0</Version>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Product>ZapperRadio</Product>
    <!-- Shown in the file properties of ZapperRadio.exe; the title is what Task Manager and the firewall call the app. -->
    <AssemblyTitle>ZapperRadio</AssemblyTitle>
    <Authors>William Veldhuizen</Authors>
    <Company>William Veldhuizen</Company>
    <Copyright>Copyright (c) 2026 William Veldhuizen</Copyright>
    <Description>ZapperRadio: instant station switching, no ads when you tune in.</Description>
    <ApplicationIcon>Assets\ZapperRadio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\ZapperRadio.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Models\yamnet.onnx;Assets\Models\LICENSE-yamnet.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The licenses and notices that go with the app, so they are in the install folder (see THIRD-PARTY-NOTICES.md). -->
  <ItemGroup>
    <Content Include="..\..\LICENSE;..\..\PRIVACY.md;..\..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\*.txt" Link="licenses\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Media Foundation decoding of the stream audio for the sound classifier. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <!-- Installs the app and updates it from the GitHub releases. Keep in step with the vpk version in the release workflow. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZapperRadio.Core\ZapperRadio.Core.csproj" />
  </ItemGroup>

  <!--
    The Microsoft Store build: the same app as an MSIX package, made with -p:StoreMsix=true (see scripts\test-msix.ps1
    and the Store MSIX workflow). Without that property nothing below applies and the app stays the unpackaged one above.
    The package is built with Visual Studio's MSBuild: the dotnet CLI cannot make the .msixupload for the Store.
  -->
  <PropertyGroup Condition="'$(StoreMsix)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- There is no .NET framework package in the Store, so the package carries .NET like the installer does. -->
    <SelfContained>true</SelfContained>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <!-- The Store signs the package; scripts\test-msix.ps1 signs a local test build itself. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <!-- A symbols package needs mspdbcmf.exe from the C++ tools, and C# portable PDBs gain nothing from it. -->
    <AppxSymbolPackageEnabled>false</AppxSymbolPackageEnabled>
    <MsPdbCmfExeFullpath>none</MsPdbCmfExeFullpath>
    <!-- Its own bin and obj, so switching between the two builds never picks up the other's leftovers. -->
    <OutputPath>bin\msix\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\msix\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- Rendered from the app icon by design\logos\app-icon\render-store-logos.ps1. -->
  <ItemGroup Condition="'$(StoreMsix)' == 'true'">
    <Content Include="Assets\Store\*.png" />
  </ItemGroup>

  <!-- The package version is the app version with a fourth part of 0, which the Store requires. -->
  <Target Name="StampMsixVersion" Condition="'$(StoreMsix)' == 'true'" BeforeTargets="_ValidatePresenceOfAppxManifestItems">
    <PropertyGroup>
      <_StampedAppxManifest>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Package.appxmanifest</_StampedAppxManifest>
    </PropertyGroup>
    <Copy SourceFiles="Package.appxmanifest" DestinationFiles="$(_StampedAppxManifest)" />
    <XmlPoke
      XmlInputPath="$(_StampedAppxManifest)"
      Query="/x:Package/x:Identity/@Version"
      Value="$(Version).0"
      Namespaces="&lt;Namespace Prefix='x' Uri='http://schemas.microsoft.com/appx/manifest/foundation/windows10' /&gt;" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(_StampedAppxManifest)" />
    </ItemGroup>
  </Target>

</Project>
