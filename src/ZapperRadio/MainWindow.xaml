<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ZapperRadio.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ZapperRadio"
    xmlns:vm="using:ZapperRadio.ViewModels"
    xmlns:models="using:ZapperRadio.Core.Models"
    Title="ZapperRadio">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <!-- Title bar, errors, the station being listened to, and then the view itself: the compact window
             puts what is playing at the top too, so both views read the same way from top to bottom. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <Style x:Key="CompactItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="10,0" />
            </Style>
        </Grid.Resources>

        <!-- Title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Only this part is the drag area, so the button beside it keeps receiving clicks. -->
            <StackPanel x:Name="TitleBarDragArea" Background="Transparent" Orientation="Horizontal" Spacing="10">
                <!-- The Z-bolt of the app icon. The broadcast arcs around it only crowd the Z at this size, so they are left to the larger icon frames. -->
                <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                    <Path
                        Data="M42,8 L24,8 L24,15 L32,15 L23,56 L41,56 L41,49 L33,49 Z"
                        Fill="{ThemeResource ZapperMarkBrush}"
                        Width="64" Height="64"
                        Stretch="None" />
                </Viewbox>
                <TextBlock Text="ZapperRadio" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Sits left of the minimize, maximize and close buttons; its margin is set in code, as their width varies. -->
            <Button
                x:Name="ViewButton"
                Grid.Column="1"
                Style="{StaticResource IconButtonStyle}"
                Width="40" Height="32"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{x:Bind local:UiHelpers.ViewToolTip(ViewModel.IsCompact), Mode=OneWay}"
                AutomationProperties.Name="{x:Bind local:UiHelpers.ViewToolTip(ViewModel.IsCompact), Mode=OneWay}"
                Command="{x:Bind ViewModel.ToggleCompactCommand}">
                <FontIcon Glyph="{x:Bind local:UiHelpers.ViewGlyph(ViewModel.IsCompact), Mode=OneWay}" FontSize="14" />
            </Button>
        </Grid>

        <StackPanel x:Name="Notices" Grid.Row="1">
            <InfoBar
                Margin="12,0,12,8"
                Severity="Warning"
                IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <!-- A new version is downloaded; it is installed when the app closes, or right away from the button. -->
            <InfoBar
                x:Uid="UpdateNotice"
                Margin="12,0,12,8"
                Severity="Success"
                IsOpen="{x:Bind ViewModel.IsUpdateNoticeOpen, Mode=TwoWay}"
                Title="{x:Bind ViewModel.UpdateNoticeTitle, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button x:Uid="RestartToUpdateButton" Command="{x:Bind ViewModel.RestartToUpdateCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Grid Grid.Row="3" Padding="12" ColumnSpacing="12" Visibility="{x:Bind ViewModel.IsFullView, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Favorites -->
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="16,14,16,8" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.FavoritesHeader, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <CheckBox
                            x:Uid="ZappCheckBox"
                            Margin="0,4,0,0"
                            IsChecked="{x:Bind ViewModel.ZappOnAdBreaks, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock
                        x:Uid="NoFavoritesText"
                        Grid.Row="1"
                        Margin="16"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind ViewModel.HasNoFavorites, Mode=OneWay}" />

                    <ListView
                        Grid.Row="1"
                        Padding="0,0,0,8"
                        ItemsSource="{x:Bind ViewModel.Favorites}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Favorite_ItemClick"
                        CanReorderItems="True"
                        CanDragItems="True"
                        AllowDrop="True"
                        GotFocus="Favorite_GotFocus"
                        LostFocus="Favorite_LostFocus">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteViewModel">
                                <Grid
                                    Background="Transparent"
                                    Padding="0,8" ColumnSpacing="10"
                                    PointerEntered="Favorite_PointerEntered"
                                    PointerExited="Favorite_PointerExited"
                                    PointerCanceled="Favorite_PointerExited"
                                    PointerCaptureLost="Favorite_PointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <!-- The remove button only shows while the row is hovered, but always keeps its place so the row does not jump. -->
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle
                                        RadiusX="1.5" RadiusY="1.5"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}" />

                                    <Grid Grid.Column="1" Width="32" Height="32" VerticalAlignment="Center">
                                        <ToolTipService.ToolTip>
                                            <ToolTip x:Uid="FavoriteLogoToolTip" />
                                        </ToolTipService.ToolTip>
                                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind Logo.ShowFallback, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind Logo.Initials, Mode=OneWay}"
                                            FontSize="12" FontWeight="SemiBold"
                                            Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{x:Bind Logo.ShowFallback, Mode=OneWay}" />
                                        <Image
                                            Source="{x:Bind Logo.Source, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind Logo.HasLogo, Mode=OneWay}"
                                            ImageOpened="FavoriteLogo_ImageOpened"
                                            ImageFailed="FavoriteLogo_ImageFailed" />
                                    </Grid>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                        <TextBlock
                                            Text="{x:Bind Song, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{x:Bind local:UiHelpers.SongBrush(IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Song, Mode=OneWay}"
                                            Visibility="{x:Bind HasSong, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasNoSong, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- The same indicator as in the compact view. -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center" Background="Transparent" ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}">
                                        <Ellipse
                                            Width="8" Height="8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Fill="{x:Bind local:UiHelpers.IndicatorBrush(Status, IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            Visibility="{x:Bind ShowDotIndicator, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="13"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Glyph="{x:Bind local:UiHelpers.IndicatorGlyph(Status, Sound), Mode=OneWay}"
                                            Foreground="{x:Bind local:UiHelpers.IndicatorBrush(Status, IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            Visibility="{x:Bind ShowIconIndicator, Mode=OneWay}" />
                                    </Grid>

                                    <Button
                                        x:Uid="RemoveFavoriteButton"
                                        Grid.Column="4"
                                        Style="{StaticResource IconButtonStyle}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind ShowActions, Mode=OneWay}"
                                        Click="RemoveFavorite_Click">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <SelectorBar x:Name="Tabs" Margin="8,4,8,0" SelectionChanged="Tabs_SelectionChanged">
                        <SelectorBarItem x:Name="StationsTab" x:Uid="StationsTab" IsSelected="True">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE93E;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <!-- The Z-bolt of the app icon, as in the title bar, scaled from its 64-unit frame to the 16 of an icon. -->
                        <SelectorBarItem x:Name="ZapperTab" x:Uid="ZapperTab">
                            <SelectorBarItem.Icon>
                                <PathIcon Data="M10.5,2 L6,2 L6,3.75 L8,3.75 L5.75,14 L10.25,14 L10.25,12.25 L8.25,12.25 Z" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="FavoriteTracksTab" Text="{x:Bind ViewModel.FavoriteTracksHeader, Mode=OneWay}">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE006;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="PlayHistoryTab" x:Uid="PlayHistoryTab">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE81C;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                        <SelectorBarItem x:Name="SettingsTab" x:Uid="SettingsTab">
                            <SelectorBarItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </SelectorBarItem.Icon>
                        </SelectorBarItem>
                    </SelectorBar>

                    <!-- Station search -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsShowingStations, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16,8,16,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="SearchBox"
                                x:Uid="SearchBox"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                KeyDown="SearchBox_KeyDown" />
                            <AutoSuggestBox
                                x:Name="CountryBox"
                                x:Uid="CountryBox"
                                Grid.Column="1"
                                QueryIcon="Filter"
                                Text="{x:Bind ViewModel.SelectedCountry, Mode=OneWay}"
                                GotFocus="Country_GotFocus"
                                LostFocus="Country_LostFocus"
                                TextChanged="Country_TextChanged"
                                QuerySubmitted="Country_QuerySubmitted" />
                            <Button
                                x:Uid="ReloadStationsButton"
                                Grid.Column="2"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32"
                                Command="{x:Bind ViewModel.ReloadCatalogCommand}">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>

                        <!-- What the search found on the left, the list it searched on the right. -->
                        <Grid Grid.Row="1" Padding="16,4,16,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind ViewModel.ResultsSummary, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressRing Grid.Column="1" Width="14" Height="14" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="2"
                                Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>

                        <!-- Nothing found: say where was searched, and offer the rest of the world when a country hid it. -->
                        <StackPanel Grid.Row="2" Margin="16" Spacing="8" Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay}">
                            <TextBlock
                                Text="{x:Bind ViewModel.NoResultsText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Button
                                x:Uid="SearchAllCountriesButton"
                                Visibility="{x:Bind ViewModel.CanSearchAllCountries, Mode=OneWay}"
                                Command="{x:Bind ViewModel.SearchAllCountriesCommand}" />
                        </StackPanel>

                        <ListView
                            x:Name="StationResults"
                            Grid.Row="2"
                            Padding="0,0,0,8"
                            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="Station_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:StationResultViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- The station being listened to, marked as in the favorites. -->
                                        <Rectangle
                                            RadiusX="1.5" RadiusY="1.5"
                                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}" />
                                        <!-- Play and add come first, so it is plain what a result is for; clicking the rest of the row plays too. -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind local:UiHelpers.PlayStationToolTip(IsActive), Mode=OneWay}"
                                                Click="PlayStation_Click">
                                                <FontIcon FontSize="16" Glyph="{x:Bind local:UiHelpers.PlayGlyph(IsActive), Mode=OneWay}" />
                                            </Button>
                                            <Button
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind local:UiHelpers.FavoriteToolTip(IsFavorite), Mode=OneWay}"
                                                Click="ToggleFavorite_Click">
                                                <FontIcon
                                                    FontSize="16"
                                                    Glyph="{x:Bind local:UiHelpers.FavoriteGlyph(IsFavorite), Mode=OneWay}"
                                                    Foreground="{x:Bind local:UiHelpers.FavoriteBrush(IsFavorite), Mode=OneWay}" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <!-- A station that failed its last check says so first, so it is not mistaken for a quiet one. -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Text="{x:Bind OfflinePrefix, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Subtitle}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Zapper: the rules the zapper follows -->
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{x:Bind ViewModel.IsShowingZapper, Mode=OneWay}">
                        <StackPanel Padding="16,8,16,16" Spacing="20">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Uid="ZapperHint"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch x:Uid="ZapperSwitch" IsOn="{x:Bind ViewModel.ZappOnAdBreaks, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Zapping is done from the keys as much as from the list, so the shortcuts stand out right under the switch. -->
                            <Border
                                Padding="14,12"
                                CornerRadius="6"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE765;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock x:Uid="ShortcutsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Uid="ShortcutsText"
                                        Margin="0,4,0,0"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        x:Uid="GlobalHotkeysCheckBox"
                                        Margin="0,6,0,0"
                                        IsChecked="{x:Bind ViewModel.GlobalHotkeys, Mode=TwoWay}" />
                                    <TextBlock
                                        x:Uid="GlobalHotkeysText"
                                        Margin="28,0,0,0"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="28,2,0,0"
                                        Text="{x:Bind ViewModel.GlobalHotkeyStatus, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasGlobalHotkeyProblem, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="ZapToSongStartHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="ZapToSongStartText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <CheckBox x:Uid="ZapToSongStartCheckBox" Margin="0,4,0,0" IsChecked="{x:Bind ViewModel.ZapToSongStart, Mode=TwoWay}" />
                                <!-- The length matters only while it is on, but stays visible so the cost of switching it on can be read. -->
                                <StackPanel Margin="28,0,0,0" Spacing="4">
                                    <ComboBox
                                        x:Uid="TimeShiftBox"
                                        MinWidth="180"
                                        IsEnabled="{x:Bind ViewModel.ZapToSongStart, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.TimeShiftOptions}"
                                        DisplayMemberPath="Name"
                                        SelectedItem="{x:Bind ViewModel.SelectedTimeShift, Mode=TwoWay}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.TimeShiftMemory, Mode=OneWay}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="ZapBackHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <RadioButton x:Uid="ZapBackRadio" GroupName="ZapBack" IsChecked="{x:Bind ViewModel.ZapBackAfterBreak, Mode=TwoWay}" />
                                <RadioButton x:Uid="ZapStayRadio" GroupName="ZapBack" IsChecked="{x:Bind ViewModel.StayAfterBreak, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="CrossfadeHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="CrossfadeText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <CheckBox x:Uid="CrossfadeCheckBox" Margin="0,4,0,0" IsChecked="{x:Bind ViewModel.CrossfadeZaps, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="ZapTargetsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    x:Uid="ZapTargetsText"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="NoZapTargetsText"
                                    Margin="0,8,0,0"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Visibility="{x:Bind ViewModel.HasNoFavorites, Mode=OneWay}" />
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{x:Bind ViewModel.Favorites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FavoriteViewModel">
                                            <CheckBox IsChecked="{x:Bind CanZapTo, Mode=TwoWay}">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Favorite tracks -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsShowingFavoriteTracks, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Padding="16,8,16,8"
                            x:Uid="FavoriteTracksHint"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            Margin="16"
                            x:Uid="NoFavoriteTracksText"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.HasNoFavoriteTracks, Mode=OneWay}" />

                        <ListView
                            Grid.Row="1"
                            Padding="0,0,0,8"
                            ItemsSource="{x:Bind ViewModel.FavoriteTracks}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:FavoriteTrack">
                                    <Grid Padding="0,6" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" IsTextSelectionEnabled="True" />
                                            <TextBlock
                                                Text="{x:Bind Details}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            x:Uid="FindSongButton">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Uid="FindOnSpotifyItem" Tag="{x:Bind Title}" Click="OpenTrackInSpotify_Click" />
                                                    <MenuFlyoutItem x:Uid="FindOnYouTubeItem" Tag="{x:Bind Title}" Click="OpenTrackOnYouTube_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            x:Uid="CopyTitleButton"
                                            Click="CopyFavoriteTrack_Click">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                        <Button
                                            Grid.Column="3"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            x:Uid="RemoveFavoriteTrackButton"
                                            Click="RemoveFavoriteTrack_Click">
                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Track history -->
                    <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.IsShowingPlayHistory, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Padding="16,8,16,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Uid="HistoryHint"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                Grid.Column="1"
                                Style="{StaticResource IconButtonStyle}"
                                Width="32" Height="32"
                                VerticalAlignment="Top"
                                x:Uid="ClearHistoryButton"
                                Command="{x:Bind ViewModel.ClearPlayHistoryCommand}">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </Grid>

                        <TextBox
                            x:Name="HistorySearchBox"
                            Grid.Row="1"
                            Margin="16,4,16,8"
                            x:Uid="HistorySearchBox"
                            Visibility="{x:Bind ViewModel.HasPlayHistory, Mode=OneWay}"
                            Text="{x:Bind ViewModel.HistorySearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock
                            Grid.Row="2"
                            Margin="16"
                            x:Uid="NoHistoryText"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.HasNoPlayHistory, Mode=OneWay}" />

                        <TextBlock
                            Grid.Row="2"
                            Margin="16"
                            x:Uid="NoHistoryMatchesText"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Visibility="{x:Bind ViewModel.HasNoHistoryMatches, Mode=OneWay}" />

                        <ListView
                            Grid.Row="2"
                            Padding="0,0,0,8"
                            ItemsSource="{x:Bind ViewModel.PlayHistoryResults}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:PlayedTrackViewModel">
                                    <Grid Padding="0,6" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" IsTextSelectionEnabled="True" />
                                            <TextBlock
                                                Text="{x:Bind Details}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="1"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{x:Bind local:UiHelpers.SaveTrackToolTip(IsSaved), Mode=OneWay}"
                                            Click="ToggleHistoryTrackSaved_Click">
                                            <FontIcon
                                                FontSize="14"
                                                Glyph="{x:Bind local:UiHelpers.HeartGlyph(IsSaved), Mode=OneWay}"
                                                Foreground="{x:Bind local:UiHelpers.HeartBrush(IsSaved), Mode=OneWay}" />
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            x:Uid="FindSongButton">
                                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem x:Uid="FindOnSpotifyItem" Tag="{x:Bind Title}" Click="OpenTrackInSpotify_Click" />
                                                    <MenuFlyoutItem x:Uid="FindOnYouTubeItem" Tag="{x:Bind Title}" Click="OpenTrackOnYouTube_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button
                                            Grid.Column="3"
                                            Style="{StaticResource IconButtonStyle}"
                                            VerticalAlignment="Center"
                                            x:Uid="CopyTitleButton"
                                            Click="CopyHistoryTrack_Click">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- Settings -->
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{x:Bind ViewModel.IsShowingSettings, Mode=OneWay}">
                        <ScrollViewer.Resources>
                            <Style x:Key="SettingsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                            </Style>
                            <Style x:Key="SettingsButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Margin" Value="0,8,0,0" />
                            </Style>
                        </ScrollViewer.Resources>

                        <StackPanel Padding="16,8,16,16" Spacing="20">
                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="StartupHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <CheckBox x:Uid="AutoStartCheckBox" IsChecked="{x:Bind ViewModel.AutoStart, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="LanguageHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="LanguageText" Style="{StaticResource SettingsTextStyle}" />
                                <!-- Every language is named in itself, so it can be found even when the rest of the window is in one that cannot be read. -->
                                <ComboBox
                                    x:Uid="LanguageBox"
                                    Margin="0,6,0,0"
                                    MinWidth="220"
                                    ItemsSource="{x:Bind ViewModel.Languages}"
                                    DisplayMemberPath="Name"
                                    SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}" />
                                <TextBlock
                                    x:Uid="LanguageRestartText"
                                    Margin="0,4,0,0"
                                    Style="{StaticResource SettingsTextStyle}"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Visibility="{x:Bind ViewModel.NeedsRestartForLanguage, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="LoudnessHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="LoudnessText" Style="{StaticResource SettingsTextStyle}" />
                                <CheckBox
                                    x:Uid="NormalizeLoudnessCheckBox"
                                    Margin="0,6,0,0"
                                    IsChecked="{x:Bind ViewModel.NormalizeLoudness, Mode=TwoWay}" />
                                <TextBlock
                                    x:Uid="NoFavoritesLoudnessText"
                                    Margin="0,2,0,0"
                                    Style="{StaticResource SettingsTextStyle}"
                                    Visibility="{x:Bind ViewModel.HasNoFavorites, Mode=OneWay}" />
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{x:Bind ViewModel.Favorites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FavoriteViewModel">
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Text="{x:Bind LoudnessText, Mode=OneWay}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    x:Uid="RemeasureLoudnessButton"
                                    Style="{StaticResource SettingsButtonStyle}"
                                    Command="{x:Bind ViewModel.RemeasureLoudnessCommand}" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="StationListHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.StationListName, Mode=OneWay}"
                                    Style="{StaticResource SettingsTextStyle}"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}"
                                    Style="{StaticResource SettingsTextStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.StationListUpdated, Mode=OneWay}"
                                    Style="{StaticResource SettingsTextStyle}" />
                                <Button
                                    x:Uid="CheckStationListButton"
                                    Style="{StaticResource SettingsButtonStyle}"
                                    Command="{x:Bind ViewModel.ReloadCatalogCommand}" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="CacheHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="CacheText" Style="{StaticResource SettingsTextStyle}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="{x:Bind ViewModel.CacheSummary, Mode=OneWay}"
                                    Style="{StaticResource SettingsTextStyle}" />
                                <Button
                                    x:Uid="ClearCacheButton"
                                    Style="{StaticResource SettingsButtonStyle}"
                                    Command="{x:Bind ViewModel.ClearCacheCommand}" />
                            </StackPanel>

                            <!-- Only for an installed app: a development build has no updates to look for. -->
                            <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.IsUpdateSupported}">
                                <TextBlock x:Uid="UpdatesHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Uid="UpdatesText" Style="{StaticResource SettingsTextStyle}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Text="{x:Bind ViewModel.UpdateStatus, Mode=OneWay}"
                                    Style="{StaticResource SettingsTextStyle}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Uid="CheckForUpdatesButton"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Command="{x:Bind ViewModel.CheckForUpdatesCommand}" />
                                    <Button
                                        x:Uid="RestartToUpdateButton"
                                        Style="{StaticResource SettingsButtonStyle}"
                                        Visibility="{x:Bind ViewModel.IsUpdateReady, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.RestartToUpdateCommand}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock x:Uid="AboutHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind local:UiHelpers.AboutVersion(ViewModel.AppVersion)}"
                                    Style="{StaticResource SettingsTextStyle}" />
                                <TextBlock x:Uid="AboutText" Style="{StaticResource SettingsTextStyle}" />
                                <!-- Aligned with the text above it, past the padding a button draws around its content. -->
                                <HyperlinkButton
                                    x:Uid="WebsiteLink"
                                    Margin="-12,2,0,0"
                                    NavigateUri="https://zapperradio.com/" />
                                <HyperlinkButton
                                    x:Uid="GitHubLink"
                                    Margin="-12,0,0,0"
                                    NavigateUri="https://github.com/WilliamVeldhuizen/ZapperRadio" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Compact view: the favorites, to click and listen, and nothing else. -->
        <Grid x:Name="CompactView" Grid.Row="3" Padding="8,0,8,8" RowSpacing="8" Visibility="{x:Bind ViewModel.IsCompact, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="CompactNowPlaying" Style="{StaticResource CardStyle}" Padding="10,8">
                <Grid ColumnSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.NowPlayingLogo.ShowFallback, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.NowPlayingLogo.Initials, Mode=OneWay}"
                            FontSize="13" FontWeight="SemiBold"
                            Foreground="White"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.NowPlayingLogo.ShowFallback, Mode=OneWay}" />
                        <Image
                            Source="{x:Bind ViewModel.NowPlayingLogo.Source, Mode=OneWay}"
                            Stretch="UniformToFill"
                            Visibility="{x:Bind ViewModel.NowPlayingLogo.HasLogo, Mode=OneWay}"
                            ImageOpened="NowPlayingLogo_ImageOpened"
                            ImageFailed="NowPlayingLogo_ImageFailed" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind ViewModel.NowPlayingName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <Grid ColumnSpacing="5" Visibility="{x:Bind ViewModel.HasNowPlayingSong, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D6;" FontSize="11" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.NowPlayingSong, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.NowPlayingSong, Mode=OneWay}" />
                            <Button
                                Grid.Column="2"
                                Width="28" Height="28" Padding="0" Margin="0,-6"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.CanSaveNowPlayingTrack, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind local:UiHelpers.SaveTrackToolTip(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:UiHelpers.SaveTrackToolTip(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleNowPlayingTrackSavedCommand}">
                                <FontIcon
                                    FontSize="17"
                                    Glyph="{x:Bind local:UiHelpers.HeartGlyph(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                    Foreground="{x:Bind local:UiHelpers.HeartBrush(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}" />
                            </Button>
                            <Button
                                Grid.Column="3"
                                Width="28" Height="28" Padding="0" Margin="0,-6"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.CanSaveNowPlayingTrack, Mode=OneWay}"
                                x:Uid="FindSongButton">
                                <FontIcon Glyph="&#xE8A7;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="FindOnSpotifyItem" Tag="{x:Bind ViewModel.NowPlayingTrack, Mode=OneWay}" Click="OpenTrackInSpotify_Click" />
                                        <MenuFlyoutItem x:Uid="FindOnYouTubeItem" Tag="{x:Bind ViewModel.NowPlayingTrack, Mode=OneWay}" Click="OpenTrackOnYouTube_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        Width="36" Height="36" CornerRadius="18" Padding="0"
                        VerticalAlignment="Center"
                        x:Uid="PlayStopButton"
                        Command="{x:Bind ViewModel.TogglePlaybackCommand}">
                        <FontIcon Glyph="{x:Bind local:UiHelpers.PlayGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="14" />
                    </Button>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,0" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The compact window shows no status line, so the button alone says the station is behind live. -->
                        <Button
                            x:Uid="GoLiveButton"
                            Grid.Column="2"
                            Padding="8,1" MinHeight="0"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsTimeShifted, Mode=OneWay}"
                            Command="{x:Bind ViewModel.GoLiveCommand}" />
                        <Button
                            Width="32" Height="32" Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="{x:Bind local:UiHelpers.MuteToolTip(ViewModel.IsMuted), Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind local:UiHelpers.MuteToolTip(ViewModel.IsMuted), Mode=OneWay}"
                            Command="{x:Bind ViewModel.ToggleMuteCommand}">
                            <FontIcon Glyph="{x:Bind local:UiHelpers.MuteGlyph(ViewModel.IsMuted), Mode=OneWay}" FontSize="14" />
                        </Button>
                        <Slider
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            x:Uid="VolumeSlider"
                            Minimum="0" Maximum="100" StepFrequency="1"
                            Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="CompactFavoritesCard" Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <TextBlock
                        x:Name="CompactNoFavorites"
                        Margin="14"
                        x:Uid="CompactNoFavorites"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Visibility="{x:Bind ViewModel.HasNoFavorites, Mode=OneWay}" />

                    <ListView
                        x:Name="CompactFavorites"
                        Padding="0,6"
                        ItemsSource="{x:Bind ViewModel.Favorites}"
                        ItemContainerStyle="{StaticResource CompactItemStyle}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Favorite_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:FavoriteViewModel">
                                <Grid Height="44" ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle
                                        Height="22" VerticalAlignment="Center"
                                        RadiusX="1.5" RadiusY="1.5"
                                        Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                        Visibility="{x:Bind IsActive, Mode=OneWay}" />

                                    <Grid Grid.Column="1" Width="28" Height="28" VerticalAlignment="Center">
                                        <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind Logo.ShowFallback, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind Logo.Initials, Mode=OneWay}"
                                            FontSize="11" FontWeight="SemiBold"
                                            Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{x:Bind Logo.ShowFallback, Mode=OneWay}" />
                                        <Image
                                            Source="{x:Bind Logo.Source, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind Logo.HasLogo, Mode=OneWay}"
                                            ImageOpened="FavoriteLogo_ImageOpened"
                                            ImageFailed="FavoriteLogo_ImageFailed" />
                                    </Grid>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
                                        <TextBlock
                                            Text="{x:Bind Song, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{x:Bind local:UiHelpers.SongBrush(IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Song, Mode=OneWay}"
                                            Visibility="{x:Bind HasSong, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind StatusText, Mode=OneWay}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{x:Bind HasNoSong, Mode=OneWay}" />
                                    </StackPanel>

                                    <!-- Green while it is live: a note for music, a speech bubble while someone talks; a yellow network icon while it connects. -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center" Background="Transparent" ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}">
                                        <Ellipse
                                            Width="8" Height="8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Fill="{x:Bind local:UiHelpers.IndicatorBrush(Status, IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            Visibility="{x:Bind ShowDotIndicator, Mode=OneWay}" />
                                        <FontIcon
                                            FontSize="13"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Glyph="{x:Bind local:UiHelpers.IndicatorGlyph(Status, Sound), Mode=OneWay}"
                                            Foreground="{x:Bind local:UiHelpers.IndicatorBrush(Status, IsAd, IsAssumedAdBreak), Mode=OneWay}"
                                            Visibility="{x:Bind ShowIconIndicator, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Now playing, above the view it belongs to, as in the compact window. -->
        <Border
            Grid.Row="2"
            Visibility="{x:Bind ViewModel.IsFullView, Mode=OneWay}"
            Padding="16,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <Button
                    Style="{StaticResource AccentButtonStyle}"
                    Width="48" Height="48" CornerRadius="24" Padding="0"
                    x:Uid="PlayStopButton"
                    Command="{x:Bind ViewModel.TogglePlaybackCommand}">
                    <FontIcon Glyph="{x:Bind local:UiHelpers.PlayGlyph(ViewModel.IsPlaying), Mode=OneWay}" FontSize="18" />
                </Button>

                <Grid Grid.Column="1" Width="40" Height="40" VerticalAlignment="Center">
                    <Ellipse Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind ViewModel.NowPlayingLogo.ShowFallback, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.NowPlayingLogo.Initials, Mode=OneWay}"
                        FontSize="14" FontWeight="SemiBold"
                        Foreground="White"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.NowPlayingLogo.ShowFallback, Mode=OneWay}" />
                    <Image
                        Source="{x:Bind ViewModel.NowPlayingLogo.Source, Mode=OneWay}"
                        Stretch="UniformToFill"
                        Visibility="{x:Bind ViewModel.NowPlayingLogo.HasLogo, Mode=OneWay}"
                        ImageOpened="NowPlayingLogo_ImageOpened"
                        ImageFailed="NowPlayingLogo_ImageFailed" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.NowPlayingName, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <Grid ColumnSpacing="6" Visibility="{x:Bind ViewModel.HasNowPlayingSong, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8D6;" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <!-- Left aligned, so the heart sits right after the song and a long song is still trimmed. -->
                        <Grid Grid.Column="1" HorizontalAlignment="Left" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.NowPlayingSong, Mode=OneWay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button
                                Grid.Column="1"
                                Width="32" Height="32" Padding="0" Margin="0,-6"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.CanSaveNowPlayingTrack, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind local:UiHelpers.SaveTrackToolTip(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                AutomationProperties.Name="{x:Bind local:UiHelpers.SaveTrackToolTip(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                Command="{x:Bind ViewModel.ToggleNowPlayingTrackSavedCommand}">
                                <FontIcon
                                    FontSize="20"
                                    Glyph="{x:Bind local:UiHelpers.HeartGlyph(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}"
                                    Foreground="{x:Bind local:UiHelpers.HeartBrush(ViewModel.IsNowPlayingTrackSaved), Mode=OneWay}" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                Width="32" Height="32" Padding="0" Margin="0,-6"
                                VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Visibility="{x:Bind ViewModel.CanSaveNowPlayingTrack, Mode=OneWay}"
                                x:Uid="FindSongButton">
                                <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem x:Uid="FindOnSpotifyItem" Tag="{x:Bind ViewModel.NowPlayingTrack, Mode=OneWay}" Click="OpenTrackInSpotify_Click" />
                                        <MenuFlyoutItem x:Uid="FindOnYouTubeItem" Tag="{x:Bind ViewModel.NowPlayingTrack, Mode=OneWay}" Click="OpenTrackOnYouTube_Click" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </Grid>
                    <!-- Left aligned, so the button sits right after the status, which says how far behind live it is. -->
                    <Grid HorizontalAlignment="Left" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind ViewModel.NowPlayingStatus, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Uid="GoLiveButton"
                            Grid.Column="1"
                            Padding="8,1" MinHeight="0" Margin="0,-4"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsTimeShifted, Mode=OneWay}"
                            Command="{x:Bind ViewModel.GoLiveCommand}" />
                    </Grid>
                </StackPanel>

                <Button
                    Grid.Column="3"
                    Width="40" Height="40" Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind local:UiHelpers.MuteToolTip(ViewModel.IsMuted), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind local:UiHelpers.MuteToolTip(ViewModel.IsMuted), Mode=OneWay}"
                    Command="{x:Bind ViewModel.ToggleMuteCommand}">
                    <FontIcon Glyph="{x:Bind local:UiHelpers.MuteGlyph(ViewModel.IsMuted), Mode=OneWay}" FontSize="16" />
                </Button>
                <Slider
                    x:Uid="VolumeSlider"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Minimum="0" Maximum="100" StepFrequency="1"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            </Grid>
        </Border>    </Grid>
</Window>
