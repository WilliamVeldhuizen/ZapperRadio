<?xml version="1.0" encoding="utf-8"?>
<!--
  The package manifest of the Microsoft Store build only. The regular build is an unpackaged app that
  ignores this file; build with -p:StoreMsix=true to package it (see the end of ZapperRadio.csproj).
  The Identity version is replaced at build time with $(Version).0, so it never has to be edited here.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity
    Name="60526williamve.ZapperRadio"
    Publisher="CN=3D06A4D8-69AB-4D79-ABEE-8C65C4A034AA"
    Version="1.0.0.0" />

  <Properties>
    <DisplayName>ZapperRadio</DisplayName>
    <PublisherDisplayName>williamve</PublisherDisplayName>
    <Logo>Assets\Store\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="nl-NL" />
    <Resource Language="de-DE" />
    <Resource Language="fr-FR" />
    <Resource Language="es-ES" />
    <Resource Language="it-IT" />
    <Resource Language="pt-BR" />
    <Resource Language="uk-UA" />
    <Resource Language="zh-CN" />
    <Resource Language="ja-JP" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="ZapperRadio"
        Description="Instant station switching, no ads when you tune in."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Store\Square150x150Logo.png"
        Square44x44Logo="Assets\Store\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Store\Wide310x150Logo.png"
          Square71x71Logo="Assets\Store\SmallTile.png"
          Square310x310Logo="Assets\Store\LargeTile.png"
          ShortName="ZapperRadio" />
        <uap:SplashScreen Image="Assets\Store\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Start with Windows" in the settings; off until the user turns it on. See StartupRegistration. -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="ZapperRadio.exe"
          EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="ZapperRadioStartup" Enabled="false" DisplayName="ZapperRadio" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
