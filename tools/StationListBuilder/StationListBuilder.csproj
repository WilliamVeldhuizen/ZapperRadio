<Project Sdk="Microsoft.NET.Sdk">

  <!-- Builds the station list published on zapperradio.com/stations; run by the Website workflow every day. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ZapperRadio.StationListBuilder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZapperRadio.Core\ZapperRadio.Core.csproj" />
  </ItemGroup>

</Project>
